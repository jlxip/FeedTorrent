include("${CMAKE_CURRENT_LIST_DIR}/openbsd.cmake")

# libtorrent does not expose libdatachannel's ICE range. Adapt only its
# signaling translation unit in the build tree; pinned sources stay pristine.
function(feedtorrent_ice_ports)
  get_target_property(sources torrent-rasterbar SOURCES)
  set(found FALSE)
  foreach(source IN LISTS sources)
    if(source MATCHES "(^|/)rtc_signaling\\.cpp$")
      get_filename_component(original "${source}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
      file(SHA256 "${original}" rtc_sha)
      if(NOT rtc_sha STREQUAL "16058554f3d04a5532275e63c18da610ba22091d038c35145015fb4310b18308")
        message(FATAL_ERROR "Review FeedTorrent ICE lifecycle adaptation before upgrading libtorrent")
      endif()
      file(READ "${original}" content)
      set(needle "rtc::Configuration config;")
      string(FIND "${content}" "${needle}" offset)
      if(offset LESS 0)
        message(FATAL_ERROR "Unexpected pinned WebRTC configuration source")
      endif()
      string(REPLACE "${needle}"
        "rtc::Configuration config;\n\tauto const ice_ports = ft::ice_port_range();\n\tconfig.portRangeBegin = ice_ports.first;\n\tconfig.portRangeEnd = ice_ports.second;"
        content "${content}")
      set(header "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../backends/libtorrent/src/native/ice_ports.h")
      set(content "#include \"${header}\"\n${content}")

      set(needle "m_offer_batches.emplace(count, std::move(handler));")
      string(REPLACE "${needle}" "torrent_status status;\n\tm_torrent->status(&status, {});\n\t// Before a tracker has reported its swarm, one offer discovers a peer.\n\t// Size later batches to the known swarm instead of reserving ten sockets blindly.\n\tstd::int64_t const peers = std::int64_t(std::max(0, status.num_complete)) + std::max(0, status.num_incomplete) - 1;\n\tcount = int(std::min<std::int64_t>(count, std::max<std::int64_t>(1, peers)));\n\t${needle}" content "${content}")
      set(needle "peer_id pid = m_torrent->pid();")
      string(REPLACE "${needle}" "${needle}\n\t\tauto reported = std::make_shared<std::atomic<bool>>(false);\n\t\ttry {\n\t\tauto outgoing_slot = ft::acquire_outgoing_ice_slot(m_torrent->settings().get_int(settings_pack::connections_limit));" content "${content}")
      set(needle "[weak_this = weak_from_this(), offer_id, pid]")
      string(REPLACE "${needle}" "[weak_this = weak_from_this(), offer_id, pid, reported, outgoing_slot]" content "${content}")
      set(needle "rtc_offer offer{std::move(offer_id), std::move(pid), std::move(sdp), {}};")
      string(REPLACE "${needle}" "if (reported->exchange(true)) return;\n\t\t\tft::track_ice_offer(pid.to_string() + std::string(offer_id.data(), offer_id.size()), outgoing_slot, [weak_this, offer_id] {\n\t\t\t\tif (auto owner = weak_this.lock()) {\n\t\t\t\t\tauto const it = owner->m_connections.find(offer_id);\n\t\t\t\t\tif (it == owner->m_connections.end() || it->second.peer_connection->state() == rtc::PeerConnection::State::Connected) return;\n\t\t\t\t\towner->on_data_channel(boost::asio::error::operation_aborted, offer_id, nullptr);\n\t\t\t\t}\n\t\t\t});\n\t\t\t${needle}" content "${content}")
      set(needle "conn.data_channel = std::move(dc);")
      string(REPLACE "${needle}" "${needle}\n\t\t} catch (std::exception const& e) {\n#ifndef TORRENT_DISABLE_LOGGING\n\t\t\tdebug_log(\"*** RTC offer failed: %s\", e.what());\n#endif\n\t\t\ton_data_channel(boost::asio::error::no_buffer_space, offer_id, nullptr);\n\t\t\tif (!reported->exchange(true)) post(m_io_context, std::bind(&rtc_signaling::on_generated_offer, shared_from_this(), boost::asio::error::no_buffer_space, rtc_offer{offer_id, pid, {}, {}}));\n\t\t}" content "${content}")
      set(needle "if (m_connections.find(offer.id) != m_connections.end())")
      string(REPLACE "${needle}" "// A peer is advertised by every tracker. Negotiate one channel per peer,\n\t// otherwise libtorrent sees several outgoing RTC handshakes and the\n\t// two endpoints can discard opposite duplicate channels.\n\tif (m_torrent->find_peer(offer.pid)) return;\n\tfor (auto const& entry : m_connections)\n\t\tif (entry.second.pid && *entry.second.pid == offer.pid) return;\n\t${needle}" content "${content}")
      set(needle "auto& conn = create_connection(offer.id,")
      string(REPLACE "${needle}" "try {\n\t${needle}" content "${content}")
      set(needle "try\n\t{\n\t\tconn.peer_connection->setRemoteDescription({offer.sdp")
      string(REPLACE "${needle}" "conn.peer_connection->setRemoteDescription({offer.sdp" content "${content}")
      set(needle "rtc::Configuration config;")
      string(REPLACE "${needle}" "auto ice_slot = ft::acquire_ice_slot(m_torrent->settings().get_int(settings_pack::connections_limit));\n\t${needle}" content "${content}")
      set(needle "[weak_this = weak_from_this(), weak_pc = make_weak_ptr(pc), offer_id, handler]")
      string(REPLACE "${needle}" "[weak_this = weak_from_this(), weak_pc = make_weak_ptr(pc), offer_id, handler, ice_slot]" content "${content}")
      set(needle "if (is_complete()) m_handler(ec, m_offers);")
      string(REPLACE "${needle}" "if (is_complete()) m_handler(m_offers.empty() ? ec : error_code{}, m_offers);" content "${content}")
      set(budget_header "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../backends/libtorrent/src/native/ice_budget.h")
      set(content "#include \"${budget_header}\"\n#include <libtorrent/torrent_status.hpp>\n${content}")

      set(generated "${CMAKE_CURRENT_BINARY_DIR}/feedtorrent-rtc_signaling.cpp")
      file(CONFIGURE OUTPUT "${generated}" CONTENT "${content}" @ONLY)
      list(REMOVE_ITEM sources "${source}")
      list(APPEND sources "${generated}")
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}" "${header}" "${budget_header}")
      set(found TRUE)
      break()
    endif()
  endforeach()
  if(NOT found)
    message(FATAL_ERROR "Missing pinned WebRTC signaling source")
  endif()
  set_property(TARGET torrent-rasterbar PROPERTY SOURCES "${sources}")
endfunction()
cmake_language(DEFER CALL feedtorrent_ice_ports)

include("${CMAKE_CURRENT_LIST_DIR}/webtorrent-admission.cmake")

# Keep the metadata-only guard from advertising a permanent upload-only peer
# during the handoff from libtorrent's metadata callback to host validation.
function(feedtorrent_metadata_gate)
  get_target_property(sources torrent-rasterbar SOURCES)
  set(found FALSE)
  foreach(source IN LISTS sources)
    if(source MATCHES "(^|/)bt_peer_connection\\.cpp$")
      get_filename_component(original "${source}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
      file(SHA256 "${original}" source_sha)
      if(NOT source_sha STREQUAL "21c74d4046e2b34ba90a31696face9ceb9bc7479c6790e67256b1c20a881cd59")
        message(FATAL_ERROR "Review FeedTorrent metadata gate before upgrading libtorrent")
      endif()
      file(READ "${original}" content)
      string(REPLACE "if (t->is_upload_only()\n#ifndef TORRENT_DISABLE_SHARE_MODE"
        "if (t->is_upload_only() && !ft::awaiting_metadata_validation(t->get_userdata())\n#ifndef TORRENT_DISABLE_SHARE_MODE"
        content "${content}")
      string(REPLACE "if (m_upload_only_id == 0) return;"
        "if (m_upload_only_id == 0) return;\n\t\tif (enabled) {\n\t\t\tauto owner = associated_torrent().lock();\n\t\t\tif (owner && ft::awaiting_metadata_validation(owner->get_userdata())) return;\n\t\t}"
        content "${content}")
      set(header "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../backends/libtorrent/src/native/metadata_gate.h")
      set(content "#include \"${header}\"\n${content}")
      string(APPEND content "\nnamespace ft {\nvoid restore_metadata_peer_cleanup(libtorrent::peer_connection_handle const& peer) {\n  if (auto native = peer.native_handle()) native->disconnect_if_redundant();\n}\n}\n")
      set(generated "${CMAKE_CURRENT_BINARY_DIR}/feedtorrent-bt_peer_connection.cpp")
      file(CONFIGURE OUTPUT "${generated}" CONTENT "${content}" @ONLY)
      list(REMOVE_ITEM sources "${source}")
      list(APPEND sources "${generated}")
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}" "${header}")
      set(found TRUE)
      break()
    endif()
  endforeach()
  if(NOT found)
    message(FATAL_ERROR "Missing pinned BitTorrent peer source")
  endif()
  set_property(TARGET torrent-rasterbar PROPERTY SOURCES "${sources}")
endfunction()
cmake_language(DEFER CALL feedtorrent_metadata_gate)
