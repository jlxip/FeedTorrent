# Reviewed fork of the pinned WebSocket tracker. Fail closed on upstream changes.
function(feedtorrent_webtorrent_admission)
  set(native "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../backends/libtorrent/src/native")
  set(original "${CMAKE_CURRENT_SOURCE_DIR}/src/websocket_tracker_connection.cpp")
  set(header "${CMAKE_CURRENT_SOURCE_DIR}/include/libtorrent/aux_/websocket_tracker_connection.hpp")
  file(SHA256 "${original}" source_sha)
  file(SHA256 "${header}" header_sha)
  if(NOT source_sha STREQUAL "e80b8650e75179c47f5998594d5924a23d0137552d918fcf23abf63f4693ebcb" OR
     NOT header_sha STREQUAL "65f9bea040f625f01b8b51452e17248efe6889f5aaf89e8383030efd56a0195f")
    message(FATAL_ERROR "Review FeedTorrent WebRTC admission sources before upgrading libtorrent")
  endif()
  get_target_property(sources torrent-rasterbar SOURCES)
  set(found FALSE)
  foreach(source IN LISTS sources)
    if(source MATCHES "(^|/)websocket_tracker_connection\\.cpp$")
      list(REMOVE_ITEM sources "${source}")
      list(APPEND sources "${native}/websocket_tracker_connection.cpp")
      set(found TRUE)
      break()
    endif()
  endforeach()
  if(NOT found)
    message(FATAL_ERROR "Missing pinned WebSocket tracker source")
  endif()
  set_property(TARGET torrent-rasterbar PROPERTY SOURCES "${sources}")
  target_include_directories(torrent-rasterbar BEFORE PRIVATE "${native}/include")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}" "${header}")
endfunction()
cmake_language(DEFER CALL feedtorrent_webtorrent_admission)
